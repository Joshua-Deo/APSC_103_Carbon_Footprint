import streamlit as st
import sqlite3
import pandas as pd
import pyodbc
from datetime import date

DB_NAME = "carbon_tracker.db"

def get_connection():
    return sqlite3.connect(DB_NAME)

def create_table():
    conn = get_connection()
    cursor = conn.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS carbon_entries (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_name TEXT NOT NULL,
            category TEXT NOT NULL,
            activity TEXT NOT NULL,
            entry_date TEXT NOT NULL,
            carbon_kg_co2e REAL NOT NULL,
            notes TEXT,
            created_at TEXT NOT NULL
        )
    """)

    conn.commit()
    conn.close()

def insert_entry(user_name, category, activity, entry_date, carbon_kg_co2e, notes):
    conn = get_connection()
    cursor = conn.cursor()

    cursor.execute("""
        INSERT INTO carbon_entries (
            user_name,
            category,
            activity,
            entry_date,
            carbon_kg_co2e,
            notes,
            created_at
        )
        VALUES (?, ?, ?, ?, ?, ?, ?)
    """, (
        user_name,
        category,
        activity,
        entry_date,
        carbon_kg_co2e,
        notes,
        datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    ))

    conn.commit()
    conn.close()

def get_all_entries():
    conn = get_connection()
    cursor = conn.cursor()

    cursor.execute("""
        SELECT id, user_name, category, activity, entry_date, carbon_kg_co2e, notes, created_at
        FROM carbon_entries
        ORDER BY entry_date DESC, id DESC
    """)

    rows = cursor.fetchall()
    conn.close()
    return rows

def get_total_footprint():
    conn = get_connection()
    cursor = conn.cursor()

    cursor.execute("SELECT SUM(carbon_kg_co2e) FROM carbon_entries")
    total = cursor.fetchone()[0]

    conn.close()
    return total if total is not None else 0()
    return conn

conn = init_db()

# --- STREAMLIT UI ---
st.set_page_config(page_title="Strava Lite", page_icon="🏃")
st.title("🏃 Strava-Lite Dashboard")

# --- SIDEBAR: Upload Activity ---
st.sidebar.header("Log a New Workout")
with st.sidebar.form("activity_form", clear_on_submit=True):
    user_name = st.text_input("Username")
    act_type = st.selectbox("Activity Type", ["Run", "Cycling", "Swim", "Walk"])
    dist = st.number_input("Distance (km)", min_value=0.0, step=0.1)
    submit = st.form_submit_button("Upload to Feed")

    if submit and user_name:
        # Save to SQL Database
        cursor = conn.cursor()
        cursor.execute("INSERT INTO activities (user, type, distance, date) VALUES (?, ?, ?, ?)",
                       (user_name, act_type, dist, str(date.today())))
        conn.commit()
        st.sidebar.success(f"Logged {act_type} for {user_name}!")

# --- MAIN PAGE: The Feed ---
st.header("Activity Feed")

# Read from SQL Database
df = pd.read_sql_query("SELECT * FROM activities ORDER BY id DESC", conn)

if not df.empty:
    # Display as a clean table
    st.dataframe(df[['date', 'user', 'type', 'distance']], use_container_width=True)
    
    # Simple Visualisation (Leaderboard)
    st.header("Leaderboard (Total Distance)")
    leaderboard = df.groupby('user')['distance'].sum().sort_values(ascending=False)
    st.bar_chart(leaderboard)
else:
